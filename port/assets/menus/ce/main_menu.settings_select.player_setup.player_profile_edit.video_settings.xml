	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/graphics_help_strings">
		<string text="The original Xbox exactly: 640x480 at 30 frames a\nsecond, nothing added." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_graphics_help_strings.i0"/>
		<string text="The original Xbox look at this device's resolution\nand frame rate, with sharper textures and HUD." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_graphics_help_strings.i1"/>
		<string text="Tastefully enhanced: the original game with soft\nshading where things meet the ground and shadows\nunder props." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_graphics_help_strings.i2"/>
		<string text="The original Xbox exactly: 640x480 at 30 frames a\nsecond, nothing added. In VR, Hardcore draws as\nClassic." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_graphics_help_strings.i3"/>
	</strings>
	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/labels">
		<string text="GRAPHICS:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i0"/>
		<string text="CRT EFFECT:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i1"/>
		<string text="DISPLAY MODE:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i2"/>
		<string text="RESOLUTION:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i3"/>
		<string text="WINDOW SIZE:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i4"/>
		<string text="RESOLUTION SCALING:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i5"/>
		<string text="V-SYNC:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i6"/>
		<string text="FRAME RATE LIMIT:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i7"/>
		<string text="FRAME RATE:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i8"/>
		<string text="SMOOTH MOTION:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i9"/>
		<string text="INSTANT AIM:" id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_labels.i10"/>
	</strings>
	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="The picture as a CRT television showed it:\nscanlines, phosphor glow, and soft color." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i0"/>
		<string text="Fullscreen takes the display; borderless covers it\nwith a window. F11 switches to the window." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i1"/>
		<string text="What fullscreen and borderless draw at. Fullscreen\nsets the display to it; borderless scales it." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i2"/>
		<string text="The window's size: 4:3, then 16:10, 16:9 and 21:9\n(its edges can also be dragged)." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i3"/>
		<string text="Native draws at the resolution; Original draws\nthe Xbox's 640x480 and scales it up." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i4"/>
		<string text="Wait for the display between frames, so that the\npicture never tears." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i5"/>
		<string text="With V-Sync off, the most frames a second. Auto:\ntwice the display's refresh rate." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i6"/>
		<string text="Unlimited can tear and uses more power. Applies\nthe next time the game starts." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i7"/>
		<string text="Draw a frame for every display refresh, blending\nbetween the game's 30 ticks per second." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i8"/>
		<string text="In first person, turn the view the moment the\nmouse moves, not up to two ticks later." id="ce.main_menu_settings_select_player_setup_player_profile_edit_video_settings.main_menu_settings_select_player_setup_player_profile_edit_video_settings_help_strings.i9"/>
	</strings>
