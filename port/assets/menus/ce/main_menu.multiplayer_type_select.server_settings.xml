		<string text="The motion tracker and nav points, for this game." id="ce.main_menu_multiplayer_type_select_server_settings.main_menu_multiplayer_type_select_server_settings_help_strings.the_motion_tracker_and_nav_point_068ddb"/>
		<string text="Friendly fire and team balance, for this game." id="ce.main_menu_multiplayer_type_select_server_settings.main_menu_multiplayer_type_select_server_settings_help_strings.friendly_fire_and_team_balance_f_45fde7"/>
		<string text="Anyone can see and join your game: it is listed\nin everyone's Server Browser." id="ce.main_menu_multiplayer_type_select_server_settings.main_menu_multiplayer_type_select_server_settings_help_strings.anyone_can_see_and_join_your_gam_a1abb6"/>
