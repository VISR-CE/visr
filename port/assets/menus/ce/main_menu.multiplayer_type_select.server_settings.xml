		<string text="Players can not be hurt by weapons and explosives\nfired by the other players." id="ce.main_menu_multiplayer_type_select_server_settings.main_menu_multiplayer_type_select_server_settings_help_strings.players_can_not_be_hurt_by_weapo_b1fe5a"/>
