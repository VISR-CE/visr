		<string text="The name the game shows in the lists of games.\nEnter changes it." id="ce.main_menu_multiplayer_type_select_server_settings.main_menu_multiplayer_type_select_server_settings_help_strings.the_name_the_game_shows_in_the_l_02355d"/>
