<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's multiplayer screens, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/op_respawn" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="bitmaps/option_bkds" color="#FF2896FF">
		<on event="a" open="main_menu/multiplayer_type_select/respawn_options_edit/respawn_options_screen"/>
		<on event="start" open="main_menu/multiplayer_type_select/respawn_options_edit/respawn_options_screen"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<child widget="main_menu/settings_select/multiplayer_setup/player_options_edit/respawn_label"/>
		<child widget="main_menu/settings_select/multiplayer_setup/player_options_edit/respawn_state" x="320" y="1"/>
	</widget>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/respawn_label" type="text" controller="1" width="320" height="22" string_list="main_menu/settings_select/multiplayer_setup/player_options_edit/player_options_labels" string_index="8" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4">
	</widget>
	<widget name="main_menu/settings_select/multiplayer_setup/player_options_edit/respawn_state" type="text" controller="1" width="148" height="22" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4">
		<data input="port respawn state"/>
	</widget>
</menus>
