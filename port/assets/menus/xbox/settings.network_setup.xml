	<strings name="xbox/settings/network_setup/help_strings">
		<string text="" />
		<string text="Host and join games over the internet by invite\nlinks; off keeps to the local network." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i0" />
		<string text="Let internet play ask the router to forward its\nport, for networks that stop connections." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i1" />
		<string text="Join the game of an invite link copied before\nswitching to the game." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i2" />
		<string text="Look for a new version when the game starts." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i3" />
		<string text="Sync saves with iCloud. Turning on applies next\nlaunch; turning off stops syncing now." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i4" />
		<string text="In multiplayer, whose names are drawn above their\nheads." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i5" />
		<string text="How large the players' names are drawn." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i6" />
		<string text="A team game's scoreboard: a column for each team,\nor every player in order of score." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i7" />
		<string text="Draw a panel behind the scoreboard, for clearer\ntext." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i8" />
		<string text="Experimental: show games on Custom Edition maps.\nThese are not fully supported yet." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i9" />
		<string text="Joining a game on a Custom Edition map you do not\nhave: download it from the players (if shared)." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i10" />
		<string text="In another's game, send its map to players who\njoin without it, as a torrent's peers do." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i11" />
		<string text="The most you send of maps to other players, so\nthat the game keeps the rest of your upload." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i12" />
		<string text="Hide offensive words in names and text from\nother players, maps, and mods as stars." id="xbox.settings_network_setup.xbox_settings_network_setup_help_strings.i13" />
	</strings>
