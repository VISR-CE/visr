	<strings name="xbox/main_menu/multiplayer_type_select/respawn_options_edit/help_strings">
		<string text="After you die, you'll be able to respawn immediately." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.after_you_die_you_ll_be_able_to__bb6af7" />
		<string text="When you die, there will be a five-second wait before\nyou can rejoin the game." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.when_you_die_there_will_be_a_fiv_8b9c5f" />
		<string text="You'll wait ten seconds after you perish before you\ncan return to the game." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.you_ll_wait_ten_seconds_after_yo_990660" />
		<string text="When you die, you must wait fifteen seconds before\nyou can respawn. This will give you an idea of what\neternity is like." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.when_you_die_you_must_wait_fifte_ef503c" />
		<string text="Respawn time will always remain at its initial\nsetting." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.respawn_time_will_always_remain__d7b6f9" />
		<string text="Every time you die your respawn time will increase\nby five seconds. Every time you kill someone your\nrespawn time will decrease by five seconds." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.every_time_you_die_your_respawn__b5be1a" />
		<string text="Your respawn time increases by ten seconds each\ntime you die, and decreases by ten seconds each\ntime you kill someone." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.your_respawn_time_increases_by_t_5ff174" />
		<string text="Every time you die you'll add fifteen seconds to your\nrespawn time. Every time you kill someone you'll\nsubtract fifteen seconds." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.every_time_you_die_you_ll_add_fi_77251e" />
		<string text="When he dies, the Odd Man Out cannot respawn until\nsomeone else assumes the shameful burden of Odd\nMan Out by dying." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.when_he_dies_the_odd_man_out_can_fa115e" />
		<string text="When you die, you will respawn immediately without\nwaiting for someone else to repeat your mistakes." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.when_you_die_you_will_respawn_im_773175" />
		<string text="You pay no price for ending your own life prematurely." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.you_pay_no_price_for_ending_your_abd4ea" />
		<string text="Every time you cause your own death, there will be a \nfive-second wait before you can rejoin the game. " id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.every_time_you_cause_your_own_de_a58b50" />
		<string text="You'll wait ten seconds after you cause your own \ndeath before you can return to the game." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.you_ll_wait_ten_seconds_after_yo_b3a1d4" />
		<string text="When you suicide, you must wait fifteen seconds \nbefore you can respawn. This will give you an idea of \nwhat eternity is like." id="xbox.main_menu_multiplayer_type_select_respawn_options_edit.xbox_main_menu_multiplayer_type_select_respawn_options_edit_help_strings.when_you_suicide_you_must_wait_f_bf856f" />
	</strings>
