	<strings name="xbox/main_menu/multiplayer_type_select/server_settings/help_strings">
		<string text="" />
		<string text="The name the game shows in the lists of games.\nEnter changes it." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i0" />
		<string text="The most players the game takes (up to 128)." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i1" />
		<string text="Players join this game by its invite link, or your\nDiscord invite. Enter copies the link again." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i2" />
		<string text="The gametype and its rules, for this game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i3" />
		<string text="Lives, health, shields, and respawning, for this game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i4" />
		<string text="Weapons, grenades, and starting equipment, for\nthis game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i5" />
		<string text="Each team's vehicles and their respawn time, for\nthis game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i6" />
		<string text="The motion tracker and nav points, for this game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i7" />
		<string text="Friendly fire and team balance, for this game." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i8" />
		<string text="Anyone can see and join your game: it is listed\nin everyone's Server Browser." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i9" />
		<string text="Only players with your invite link can join." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i10" />
		<string text="Players can not be hurt by weapons and explosives\nfired by the other players." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i11" />
		<string text="Players can be hurt by weapons or explosives\nfired by the other players." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i12" />
		<string text="Damage from the other players will only reduce\nshields. Health will be unaffected." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i13" />
		<string text="Players can be hurt by damage from explosives\nfired by the other players." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i14" />
		<string text="Enemy squads are as the campaign has them." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i15" />
		<string text="Enemy squads grow with the players: by the amount\nbelow for each player past the first." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i16" />
		<string text="Enemy squads are the amount below times as large,\nhowever many players there are." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i17" />
		<string text="For each player past the first, enemy squads get\nthis much more of themselves (100%: as many again)." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i18" />
		<string text="Each enemy squad is this many times as large." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i19" />
		<string text="Players bump into each other, as in the campaign." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i20" />
		<string text="Players walk through each other, so that no one\nblocks a doorway. The AI's characters still block." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i21" />
		<string text="Players from the Server Browser must type it to\njoin (an invite link needs none). Enter sets it." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i22" />
		<string text="Players who join without the game's Custom Edition\nmap download it from you and the other players." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i23" />
		<string text="Players who join without the map cannot play." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i24" />
		<string text="Players can hurt friendly AI and vehicles." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i25" />
		<string text="Friendly AI and vehicles are protected from players.\nPlayer-to-player friendly fire keeps its own rules." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i26" />
		<string text="More players than recommended for this device.\nIt may run slowly." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i27" />
		<string text="Players can leave and join at any time.\nPlayers always respawn in place upon death." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i28" />
		<string text="Fireteam cannot change after level start.\nIf the whole team dies, revert to checkpoint." id="xbox.main_menu_multiplayer_type_select_server_settings.xbox_main_menu_multiplayer_type_select_server_settings_help_strings.i29" />
