	<strings name="xbox/main_menu/multiplayer_type_select/server_settings/help_strings">
		<string text="" />
		<string text="The name the game shows in the lists of games.\nEnter changes it." />
		<string text="The most players the game takes (up to 128)." />
		<string text="Players join this game by its invite link, or your\nDiscord invite. Enter copies the link again." />
		<string text="The gametype and its rules, for this game." />
		<string text="Lives, health, shields and respawning, for this game." />
		<string text="Weapons, grenades and starting equipment, for\nthis game." />
		<string text="Each team's vehicles and their respawn time, for\nthis game." />
		<string text="The motion tracker and nav points, for this game." />
		<string text="Friendly fire and team balance, for this game." />
		<string text="Anyone can see and join your game: it is listed\nin everyone's Server Browser." />
		<string text="Only players with your invite link can join." />
		<string text="Players can not be hurt by weapons and explosives\nfired by the other players." />
		<string text="Players can be hurt by weapons or explosives\nfired by the other players." />
		<string text="Damage from the other players will only reduce\nshields. Health will be unaffected." />
		<string text="Players can be hurt by damage from explosives\nfired by the other players." />
		<string text="Enemy squads are as the campaign has them." />
		<string text="Enemy squads grow with the players: by the amount\nbelow for each player past the first." />
		<string text="Enemy squads are the amount below times as large,\nhowever many players there are." />
		<string text="For each player past the first, enemy squads get\nthis much more of themselves (100%: as many again)." />
		<string text="Each enemy squad is this many times as large." />
		<string text="Players bump into each other, as in the campaign." />
		<string text="Players walk through each other, so that no one\nblocks a doorway. The AI's characters still block." />
		<string text="Players from the Server Browser must type it to\njoin (an invite link needs none). Enter sets it." />
		<string text="Players who join without the game's Custom Edition\nmap download it from you and the other players." />
		<string text="Players who join without the map cannot play." />
		<string text="Players can hurt friendly AI and vehicles." />
		<string text="Friendly AI and vehicles are protected from players.\nPlayer-to-player friendly fire keeps its own rules." />
		<string text="More players than recommended for this device.\nIt may run slowly." />
		<string text="Players can leave and join at any time.\nPlayers always respawn in place upon death." />
		<string text="Fireteam cannot change after level start.\nIf the whole team dies, revert to checkpoint." />
		<string text="Friendly fire, extra enemies, player collisions\nand what happens when everyone dies." />
		<string text="Players and friendly AI are protected from\nplayers' weapons and explosives." />
		<string text="Players can hurt each other. Friendly AI is\nprotected from players." />
		<string text="Players can hurt friendly AI and vehicles.\nPlayers are protected from each other." />
		<string text="Players can hurt each other, friendly AI and\nvehicles." />
	</strings>
