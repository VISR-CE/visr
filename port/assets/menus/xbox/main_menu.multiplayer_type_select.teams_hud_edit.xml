	<strings name="xbox/main_menu/multiplayer_type_select/teams_hud_edit/help_strings">
		<string text="Players can not be hurt by weapons and explosives\nfired by their teammates." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_can_not_be_hurt_by_weapo_f42723" />
		<string text="Players can be hurt by weapons or explosives\nfired by their teammates." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_can_be_hurt_by_weapons_o_a40947" />
		<string text="Damage from friendly fire will only reduce shields.\nHealth will be unaffected." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.damage_from_friendly_fire_will_o_d99200" />
		<string text="Players can be hurt by damage from explosives \nfired by their teammates." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_can_be_hurt_by_damage_fr_2e04b2" />
		<string text="No respawn time penalty will be assessed to players\nwho kill a teammate." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.no_respawn_time_penalty_will_be__49a8c9" />
		<string text="Players who kill a teammate will be assessed a \nfive-second respawn penalty the next time they die." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_who_kill_a_teammate_will_9888f4" />
		<string text="Players who kill a teammate will be assessed a \nten-second respawn penalty the next time they die." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_who_kill_a_teammate_will_551ffb" />
		<string text="Players who kill a teammate will be assessed\na fifteen-second respawn penalty the next time\nthey die." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.players_who_kill_a_teammate_will_c8e1b7" />
		<string text="Team autobalancing will be disabled.  Players will\nbe free to change teams as they wish." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.team_autobalancing_will_be_disab_52927b" />
		<string text="Team autobalancing will be enabled.  Players will\nnot be able to change to a more full team." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.team_autobalancing_will_be_enabl_62458a" />
		<string text="The game's objectives (hills, flags, balls and the like)\nwill appear in your Motion Tracker." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.the_game_s_objectives_hills_flag_999404" />
		<string text="The game's objectives will have special markers\ndisplayed over them on screen." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.the_game_s_objectives_will_have__dc6a6c" />
		<string text="The game's objectives will not be visible in your\nMotion Tracker or on screen." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.the_game_s_objectives_will_not_b_ff68d4" />
		<string text="All other players in the game will show up on your \nMotion Tracker when mobile." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.all_other_players_in_the_game_wi_2eed11" />
		<string text="Other friendly players in the game will show up on \nyour Motion Tracker when mobile." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.other_friendly_players_in_the_ga_568d12" />
		<string text="Other players in the game will never show up on your\nMotion Tracker." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.other_players_in_the_game_will_n_93323d" />
		<string text="Green triangles will appear over the heads of your\nteammates as a reminder that you should not shoot\nthem." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.green_triangles_will_appear_over_f13744" />
		<string text="Your teammates will only be denoted by the color of\ntheir armor." id="xbox.main_menu_multiplayer_type_select_teams_hud_edit.xbox_main_menu_multiplayer_type_select_teams_hud_edit_help_strings.your_teammates_will_only_be_deno_5c8d39" />
