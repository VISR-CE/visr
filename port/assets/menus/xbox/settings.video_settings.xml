	<strings name="xbox/settings/video_settings/graphics_help_strings">
		<string text="The original Xbox exactly: 640x480 at 30 frames a\nsecond, nothing added." />
		<string text="The original Xbox look at this device's resolution\nand frame rate, with sharper textures and HUD." />
		<string text="Tastefully enhanced: the original game with soft\nshading where things meet the ground and shadows\nunder props." />
		<string text="The original Xbox exactly: 640x480 at 30 frames a\nsecond, nothing added. In VR, Hardcore draws as\nClassic." />
	</strings>
	<strings name="xbox/settings/video_settings/labels">
		<string text="GRAPHICS:" />
